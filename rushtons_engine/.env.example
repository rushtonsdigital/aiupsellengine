# Copy to .env and fill in. Without a .env the engine runs on a local SQLite
# file (rushtons.db).

# Supabase Postgres (EU region). Dashboard -> Connect -> Session pooler URI.
# Use the SESSION POOLER string (aws-…-…pooler.supabase.com:5432) — the direct
# db.<ref>.supabase.co host is IPv6-only and fails on most home/office networks.
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Optional overrides
# DATA_DIR=C:\path\to\weekly\exports
# EXPORT_DIR=C:\path\to\sharepoint\folder
